# ignore everything in ~/.config by default
/*

# ...except these
!.gitignore
!hypr/
!kitty/
!nvim/
!noctalia/
!fcitx5/
!spicetify/
!fastfetch/
!bashrc
!pkglist.txt
!vesktop/
vesktop/*
!vesktop/themes/
!vesktop/settings/
!gtk-3.0/
!gtk-4.0/

# skip spicetify's large/machine-specific folders
spicetify/Backup/
spicetify/Extracted/
